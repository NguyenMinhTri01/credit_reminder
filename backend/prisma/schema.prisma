generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum ReminderFrequency {
  MONTHLY
  QUARTERLY
  ONE_TIME
}

enum TransactionSource {
  MANUAL
  GMAIL
}

enum NotificationType {
  CARD_DUE
  REMINDER
  SYSTEM
}

enum NotificationChannel {
  ZALO
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
  PENDING
}

// Models
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  zaloId       String?  @map("zalo_id")
  fullName     String?  @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  creditCards     CreditCard[]
  reminders       Reminder[]
  notifications   NotificationLog[]
  gmailConnection GmailConnection?

  @@map("users")
}

model CreditCard {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  bankName         String   @map("bank_name")
  cardName         String   @map("card_name")
  cardNumberMasked String?  @map("card_number_masked") @db.VarChar(20)
  creditLimit      Decimal? @map("credit_limit") @db.Decimal(15, 2)
  currentBalance   Decimal  @default(0) @map("current_balance") @db.Decimal(15, 2)
  statementDay     Int?     @map("statement_day")
  dueDay           Int?     @map("due_day")
  encryptedData    Json?    @map("encrypted_data")
  createdAt        DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("credit_cards")
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  cardId          String            @map("card_id") @db.Uuid
  amount          Decimal           @db.Decimal(15, 2)
  transactionDate DateTime          @map("transaction_date") @db.Date
  description     String?
  merchant        String?
  source          TransactionSource @default(MANUAL)
  rawEmailId      String?           @map("raw_email_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  card CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Reminder {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  title               String
  amount              Decimal?           @db.Decimal(15, 2)
  frequency           ReminderFrequency?
  nextTriggerDate     DateTime           @map("next_trigger_date") @db.Date
  isActive            Boolean            @default(true) @map("is_active")
  zaloMessageTemplate String?            @map("zalo_message_template")
  createdAt           DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("reminders")
}

model NotificationLog {
  id      String              @id @default(uuid()) @db.Uuid
  userId  String              @map("user_id") @db.Uuid
  type    NotificationType?
  channel NotificationChannel @default(ZALO)
  message String?
  sentAt  DateTime?           @map("sent_at")
  status  NotificationStatus  @default(PENDING)

  user User @relation(fields: [userId], references: [id])

  @@map("notification_logs")
}

model GmailConnection {
  userId       String    @id @db.Uuid
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  lastSyncAt   DateTime? @map("last_sync_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_connections")
}
